# =============================================================================
# ENV CONFIGURATION TEMPLATE: xiangqi_robot_TrainningAI_Final_6
# Copy file này thành `.env` và điền các giá trị phù hợp với môi trường của bạn:
#   copy .env.example .env
# =============================================================================

# Token xác thực API trận đấu ảo (tuongkydaisu.com)
# Cần liên hệ quản trị viên để được cấp token role SIMULATION.
SIMULATION_TOKEN=

# Địa chỉ IP của tủ điều khiển Robot Fairino FR5
ROBOT_IP=192.168.58.2

# Chỉ số camera giám sát (0: webcam tích hợp, 1: USB camera, 2: DroidCam, ...)
VIDEO_SOURCE=2

# Chế độ chạy thử không kết nối phần cứng (True = DRY RUN, False = REAL RUN)
DRY_RUN=False
